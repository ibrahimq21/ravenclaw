# Ravenclaw Email Bridge - Environment Variables
# SECURE - Never commit to version control!

# ========== EMAIL (Required) ==========
EMAIL_USERNAME=your.email@domain.com
EMAIL_PASSWORD=YourPasswordHere
EMAIL_HOST=mail.example.com
EMAIL_POP_PORT=995
EMAIL_SMTP_PORT=587

# ========== DOMAIN FILTER (Required) ==========
# Only emails from these domains will be processed and saved to inbox JSON
# Separate multiple domains with comma: example.com,partner.org,another.net
# This allowlist applies to inbound mail AND to every outbound recipient
# (To, CC and BCC) on the /send and /schedule endpoints.
DOMAIN_FILTER=example.com

# ========== DISCORD (Optional) ==========
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx
DISCORD_USE_WEBHOOK=false
OPENCLAW_URL=http://localhost:3000/api/message
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# ========== BRIDGE SETTINGS ==========
# Loopback by default. The API can read your whole inbox and send mail as
# this account, so only bind a non-loopback address behind a reverse proxy -
# and the bridge refuses to start on one without RAVENCLAW_API_KEY set.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=5002
BRIDGE_POLL_INTERVAL=30

# ========== API AUTH (Required to use the API) ==========
# Every route except /health requires a key in an X-API-Key header.
# Without one the API returns 503. Generate keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Single shared key. Sends made with it are attributed to 'default'.
RAVENCLAW_API_KEY=

# Named keys: 'actor:key' pairs, comma-separated. Preferred - each client
# gets its own identity, so /sent shows who sent what and you can revoke one
# client without disturbing the others.
#   RAVENCLAW_API_KEYS=alice:key_aaa,bot:key_bbb,scheduler:key_ccc
RAVENCLAW_API_KEYS=

# ========== ATTACHMENTS ==========
# The ONLY folder a caller may reference by name, e.g. {"file": "report.pdf"}.
# Callers cannot pass absolute paths or escape this folder with '..', so the
# API can never be used to mail out an arbitrary file from this machine.
ATTACHMENT_DIR=attachments

# Blob store backing drafts and the scheduled queue. Content-addressed, so an
# identical file attached many times is stored once. Safe to delete when the
# bridge is stopped; unreferenced blobs are cleaned up automatically.
ATTACHMENT_STORE=ravenclaw_attachments

# Size caps, in bytes. Defaults: 10 MB per file, 25 MB per message.
# Your mail server almost certainly enforces its own, usually lower, limit.
MAX_ATTACHMENT_BYTES=10485760
MAX_TOTAL_ATTACHMENT_BYTES=26214400

# ========== INBOUND ATTACHMENTS ==========
# Files that arrive ON email are written here, one folder per sender, e.g.
# inbox_attachments/ali.khan_at_example.com/invoice.pdf. Deliberately separate
# from ATTACHMENT_STORE above: that store is garbage-collected against drafts
# and the scheduled queue, which would delete received files.
#
# This location can also be changed while the bridge is running:
#   PUT /config/attachments  {"inbound_dir": "D:/MyMail/files"}
# The endpoint validates and creates the folder, then writes the new value back
# to this file, so a runtime change survives a restart. Each stored attachment
# records the folder it was written to, so moving this does not break the older
# ones; pass "move_existing": true to relocate them too.
INBOUND_ATTACHMENT_DIR=inbox_attachments

# Set false to receive mail without keeping its attachments on disk.
SAVE_INBOUND_ATTACHMENTS=true

# Size caps for received files, in bytes. Defaults: 10 MB per file, 25 MB per
# message. A file over either cap is skipped and noted in the inbox record;
# the rest of the email is stored as normal.
MAX_INBOUND_ATTACHMENT_BYTES=10485760
MAX_INBOUND_TOTAL_BYTES=26214400

# ========== RAW MESSAGES (.eml) ==========
# Received emails are also kept whole here, exactly as they arrived, so that
# GET /inbox/<id>/raw.eml can hand one back as a .eml that opens in any mail
# client. This is the only copy that keeps the HTML body, the full header set
# and the original MIME structure - the inbox JSON stores just the plain-text
# part. Content-addressed, so the same message re-fetched costs one file.
#
# A third store, separate from both above for the same reason they are separate
# from each other: this one is garbage-collected against the inbox, and blobs
# are dropped only when their email falls off the end of it.
#
# Contains entire emails, so treat it as sensitive. Safe to delete when the
# bridge is stopped - the endpoint then rebuilds a .eml from the inbox JSON
# instead, clearly marked as reconstructed.
RAW_EML_DIR=ravenclaw_raw

# ========== DUPLICATE PREVENTION ==========
# Seconds during which an identical message (same recipients, subject and
# body) is treated as an accidental repeat and suppressed. Callers that send
# an Idempotency-Key header are deduplicated exactly, at any age; this window
# is the safety net for callers that do not. Set 0 to disable the window.
SEND_DEDUPE_WINDOW=300

# Display name on outgoing mail
SENDER_NAME=Your Name

# ========== AUTO-REPLY ==========
AUTO_REPLY_ENABLED=false
AUTO_REPLY_TEMPLATE=Thank you for your email. I've received it and will respond shortly.

# ========== FILES CREATED ==========
# ravenclaw_inbox.json - Received emails (JSON)
# ravenclaw_outbox.json - Record of sent mail: when, by whom, Message-ID
# ravenclaw_scheduled.json - Scheduled emails queue
# ravenclaw_sent.json - Persistent sent email IDs (prevents re-sending)
# ravenclaw_processed.txt - Processed message IDs
# ravenclaw.log - Bridge logs

# ========== GOOGLE CALENDAR BRIDGE (Optional) ==========
# Get API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=YOUR_API_KEY_HERE

# Calendar ID (use 'primary' for your main calendar)
CALENDAR_ID=primary

# ========== GOOGLE CALENDAR BRIDGE (Optional) ==========
DISCORD_WEBHOOK_URL_FOR_CALENDAR=https://discord.com/api/webhooks/xxxxx/xxxxx

# ========== POLLING SETTINGS ==========
# Poll interval in seconds (default: 60)
POLL_INTERVAL=60

# Look ahead for events in minutes (default: 60)
EVENT_LOOKAHEAD=60
